{
  "name": "lead-gen-system",
  "version": "1.0.0",
  "description": "A production-grade, enterprise-level TypeScript system for automated lead generation and email enrichment.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "api": "ts-node-dev --respawn src/api/server.ts",
    "cli": "ts-node-dev --respawn src/cli/index.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "drizzle-kit": "^0.20.14",
    "jest": "^29.7.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.29.3",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "winston": "^3.11.0"
  }
}
